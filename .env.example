# ============================================================
# AzadiWish — Environment Variables (Cloudflare Secrets)
# ============================================================
# Store these in Cloudflare Pages Environment Variables
# (Not in code — for security)
# ============================================================

# ===== AD NETWORK IDs =====
# Propeller Ads (https://www.propellerads.com)
CF_PROPELLER_PUB_ID=YOUR_PROPELLER_PUBLISHER_ID

# Ezoic (https://www.ezoic.com)
CF_EZOIC_SITE_ID=YOUR_EZOIC_SITE_ID

# Media.net (https://www.media.net)
CF_MEDIANET_CID=YOUR_MEDIANET_CUSTOMER_ID

# ===== AFFILIATE IDs =====
# Flipkart Affiliate (https://affiliation.flipkart.com)
CF_FLIPKART_TRACKING_ID=YOUR_FLIPKART_AFFILIATE_ID

# Amazon Associates (https://affiliate-program.amazon.in)
CF_AMAZON_ASSOCIATE_TAG=YOUR_AMAZON_TAG_ID

# FNP Affiliate (https://www.fnp.com/partner-with-us)
CF_FNP_CAMPAIGN_URL=https://www.fnp.com/?utm_source=azadiwish&utm_medium=affiliate&utm_campaign=indday

# ===== TRACKING PIXELS =====
# Conversion pixels for affiliate networks
CF_FLIPKART_PIXEL_ID=YOUR_FLIPKART_CONVERSION_PIXEL
CF_AMAZON_PIXEL_ID=YOUR_AMAZON_CONVERSION_PIXEL
CF_FNP_PIXEL_ID=YOUR_FNP_CONVERSION_PIXEL

# ===== ANALYTICS =====
# Google Analytics 4
GA4_MEASUREMENT_ID=G-TPF23RP7M3

# ===== CONFIGURATION FLAGS =====
# Which ad network to use: propeller | ezoic | medianet | off
AD_NETWORK=propeller

# Enable affiliate tracking
TRACK_AFFILIATE_CLICKS=true
TRACK_AD_IMPRESSIONS=true
TRACK_CONVERSIONS=true

# ===== AI QUOTES (Optional) =====
# Set to true if you deploy the /api/quote function
USE_AI_QUOTES=false
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
